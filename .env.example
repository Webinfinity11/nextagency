# Postgres connection (Railway: reference the Postgres service's DATABASE_URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# The one admin login for /admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="a-long-random-password"
# Signs the admin session cookie: 32+ random bytes, e.g. `openssl rand -hex 32`.
SESSION_SECRET=""
# Where uploaded images/videos are stored. Production needs an absolute path: a mounted Railway volume such as /data/uploads.
UPLOAD_DIR="./uploads"
